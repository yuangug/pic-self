{
  "manifest_version": 2,
  "id": "com.github.whitecloudol.pic-video-draw",
  "version": "1.6.0",
  "name": "PicVideoDraw",
  "description": "让麦麦拥有图片创建、图片编辑和视频生成的能力，支持 OpenAI 兼容与 Agnes 多模态模型",
  "author": {
    "name": "清蒸云鸭",
    "url": "https://github.com/WhiteCloudOL"
  },
  "license": "AGPL-3.0",
  "urls": {
    "repository": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin",
    "homepage": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin",
    "documentation": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin/blob/main/README.md",
    "issues": "https://github.com/WhiteCloudOL/maimai-drawpic-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.0.0"
    },
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=9.0.0"
    }
  ],
  "plugin_type": "media",
  "capabilities": [
    "send.text",
    "send.image",
    "llm.generate",
    "chat.get_all_streams",
    "chat.get_group_streams",
    "chat.get_private_streams",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "message.get_recent",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
